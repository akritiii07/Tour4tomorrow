# Client-side settings. Anything starting with VITE_ is bundled into the
# browser code and is PUBLIC — never put API keys or secrets here.

# Leave empty in development (Vite proxies /api to http://localhost:5000).
# In production, if the API is on a different domain, set it, e.g.:
# VITE_API_URL=https://tour4tomorrow-api.onrender.com/api
VITE_API_URL=
