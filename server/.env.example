# ─────────────────────────────────────────────────────────────
# Tour4Tomorrow server configuration
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit your real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------
NODE_ENV=development
PORT=5000
# The URL the React app runs on (used for CORS). Vite default is 5173.
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas (REQUIRED) -----------------------------------
# Atlas → your cluster → Connect → Drivers → copy the connection string.
# Replace <username>, <password> and add a database name (tour4tomorrow).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/tour4tomorrow?retryWrites=true&w=majority

# --- Authentication (REQUIRED) ----------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI chatbot (needed only for the chatbot) -------------------
# Choose ONE provider: gemini | anthropic
AI_PROVIDER=gemini

# Google Gemini — key from https://aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude — key from https://platform.claude.com (paid, prepaid credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Maps & routes (optional, improves accuracy) ----------------
# openrouteservice — free key at https://openrouteservice.org/dev/#/signup
# Without it the app falls back to OpenStreetMap Nominatim geocoding and an
# ESTIMATED road distance (straight-line distance × 1.25), clearly labelled.
ORS_API_KEY=

# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT=Tour4Tomorrow-student-project/1.0 (your-email@example.com)

# --- Rewards ----------------------------------------------------
# Max Carbon Points a user can earn per day (stops point farming).
DAILY_POINTS_CAP=100
